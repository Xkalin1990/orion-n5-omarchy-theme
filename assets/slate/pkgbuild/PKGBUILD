pkgname=slate
pkgver=0.1.0
pkgrel=1
pkgdesc='Frameless, draggable instant telemetry scratchpad widget'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/slate "$pkgdir/usr/bin/slate"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/slate.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/slate.svg"
  install -Dm644 "$startdir/slate.desktop" "$pkgdir/usr/share/applications/slate.desktop"
}
