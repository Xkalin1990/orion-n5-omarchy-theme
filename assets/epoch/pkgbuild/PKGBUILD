pkgname=epoch
pkgver=0.1.0
pkgrel=1
pkgdesc='Live, theme-styled, frameless desktop clock and date widget'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/epoch "$pkgdir/usr/bin/epoch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/epoch.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/epoch.svg"
  install -Dm644 "$startdir/epoch.desktop" "$pkgdir/usr/share/applications/epoch.desktop"
}
