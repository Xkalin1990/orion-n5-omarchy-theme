pkgname=tminus
pkgver=0.1.0
pkgrel=1
pkgdesc='Frameless, draggable mission countdown and Pomodoro timer widget'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/tminus "$pkgdir/usr/bin/tminus"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/tminus.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tminus.svg"
  install -Dm644 "$startdir/tminus.desktop" "$pkgdir/usr/share/applications/tminus.desktop"
}
