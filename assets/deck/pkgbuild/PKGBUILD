pkgname=deck
pkgver=0.1.0
pkgrel=1
pkgdesc='Orion N5 unified desktop telemetry widget pack (epoch, tminus, uplink, signal, slate, zulu)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'playerctl' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/deck "$pkgdir/usr/bin/deck"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/deck.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/deck.svg"
  install -Dm644 "$startdir/deck.desktop" "$pkgdir/usr/share/applications/deck.desktop"
}
