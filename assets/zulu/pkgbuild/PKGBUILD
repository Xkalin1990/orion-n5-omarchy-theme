pkgname=zulu
pkgver=0.1.0
pkgrel=1
pkgdesc='Frameless, draggable multi-zone mission clock strip widget'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/zulu "$pkgdir/usr/bin/zulu"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/zulu.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/zulu.svg"
  install -Dm644 "$startdir/zulu.desktop" "$pkgdir/usr/share/applications/zulu.desktop"
}
